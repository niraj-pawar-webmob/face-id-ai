# local db connection url
DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5433/faceid_local"


# webmob server db connection url
# DATABASE_URL="postgresql+psycopg2://faceid:faceid743@192.168.10.42:15432/faceid-db"

MATCH_THRESHOLD=0.35
GPU=1
MAX_FACES=20
DB_VERIFY=1


# cache entries live for these many seconds
EMBEDDING_CACHE_TTL_SECONDS=300  # 5 minutes

# optional: max number of persons to keep in local cache
EMBEDDING_CACHE_MAX_SIZE=512



